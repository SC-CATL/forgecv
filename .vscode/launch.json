{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "ForgeCV (venv)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": {
        "PYTHONUTF8": "1"
      }
    },
    {
      "name": "ForgeCV 自检 (venv)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "args": ["--self-test"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "env": {
        "PYTHONUTF8": "1",
        "ENVIRONMENT": "test",
        "QT_QPA_PLATFORM": "offscreen"
      }
    }
  ]
}
